AccessType=ro
PDOMapping=0

[6000sub7]
ParameterName=Input 7
DataType=0x0005        ; uint8
AccessType=ro
PDOMapping=0

[6000sub8]
ParameterName=Input 8
DataType=0x0005        ; uint8
AccessType=ro
PDOMapping=0

[6200]
ParameterName=Digital Outputs
ObjectType=0x7
DataType=0x0006  ; Unsigned16 for 16-bit digital output
AccessType=rw
DefaultValue=0x0000
PDOMapping=1

