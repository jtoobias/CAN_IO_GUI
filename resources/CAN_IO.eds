[DigitalIOObjects]
6000=1
6200=1

[6000]
ParameterName=Digital Inputs
ObjectType=0x9  ; Array
SubNumber=9
PDOMapping=1

[6000sub0]
SubNumber=9            ; Total number of subindices (including 0)
ParameterName=All Inputs
ObjectType=0x7         ; Variable for all inputs combined
DataType=0x0006        ; Unsigned16
AccessType=ro
DefaultValue=0x0000    ; Default value (16-bit word)
PDOMapping=1           ; Map the entire 16-bit word to a PDO

[6000sub1]
ParameterName=Input 1
DataType=0x0005        ; uint8
AccessType=ro
PDOMapping=0           ; Cant be mapped to PDOs

[6000sub2]
ParameterName=Input 2
DataType=0x0005        ; uint8
AccessType=ro
PDOMapping=0

[6000sub3]
ParameterName=Input 3
DataType=0x0005        ; uint8
AccessType=ro
PDOMapping=0

[6000sub4]
ParameterName=Input 4
